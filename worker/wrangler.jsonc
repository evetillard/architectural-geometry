{
  "$schema": "../node_modules/wrangler/config-schema.json",

  "name": "architectural-geometry-suggestions-staging",

  "main": "src/index.mjs",

  "compatibility_date": "2026-08-31",

  "vars": {
    "ENVIRONMENT": "local",
    "GITHUB_DELIVERY_ENABLED": "false"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "architectural-geometry-suggestions-local",

      // Identifiant factice utilisable uniquement en développement local.
      // Il sera remplacé par l'identifiant réel de la base de staging.
      "database_id": "00000000-0000-0000-0000-000000000000",

      "migrations_dir": "migrations"
    }
  ],

  // Aucun véritable Cron ne sera créé tant que la livraison GitHub
  // du Worker n'aura pas été configurée et testée.
  "triggers": {
    "crons": []
  },

  "observability": {
    "enabled": true
  }
}