{
  "name": "architectural-geometry",
  "private": true,
  "scripts": {
    "start": "jupyter-book start",
    "build": "npm run check:bibliography && jupyter-book build --html",
    "new:surface": "node scripts/new-surface.mjs",
    "sync:bibliography": "node scripts/sync-bibliography.mjs",
    "check:bibliography": "node scripts/sync-bibliography.mjs --check",
    "test:suggestions": "node scripts/check-suggestion-schema.mjs",
    "start:storage": "node scripts/suggestion-storage-server.mjs",
    "dev": "concurrently --kill-others-on-fail --names site,storage --prefix-colors cyan,magenta npm:start npm:start:storage"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "concurrently": "10.0.5",
    "jupyter-book": "2.1.6"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  }
}
